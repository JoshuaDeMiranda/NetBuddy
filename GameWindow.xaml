<Window x:Class="Prog_POE_Part_2.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetBuddy - Cybersecurity Quiz"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cybersecurity Mini-Game"
                   FontSize="20" FontWeight="Bold" Foreground="Cyan" Margin="0,0,0,6"/>

        <TextBlock x:Name="QuizScoreText" Grid.Row="1" Text="Score: 0"
                   Foreground="LightGreen" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock x:Name="QuizQuestionText" Grid.Row="2" Text="Loading question..."
                   Foreground="White" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel x:Name="OptionsPanel" Grid.Row="3"/>

        <TextBlock x:Name="QuizFeedbackText" Grid.Row="4"
                   Foreground="Gold" TextWrapping="Wrap" Margin="0,8,0,8"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button x:Name="SubmitAnswerButton" Content="Submit Answer"
                    Background="#2196F3" Foreground="White" Padding="10,6" Margin="4"
                    BorderThickness="0" Click="SubmitAnswerButton_Click"/>
            <Button x:Name="NextQuestionButton" Content="Next"
                    Background="#4CAF50" Foreground="White" Padding="10,6" Margin="4"
                    BorderThickness="0" Click="NextQuestionButton_Click" IsEnabled="False"/>
            <Button x:Name="RestartButton" Content="Restart"
                    Background="#4CAF50" Foreground="White" Padding="10,6" Margin="4"
                    BorderThickness="0" Click="RestartButton_Click"/>
            <Button Content="Close"
                    Background="#E53935" Foreground="White" Padding="10,6" Margin="4"
                    BorderThickness="0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
