<Window x:Class="Prog_POE_Part_2.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetBuddy - Activity Log"
        Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        Closed="Window_Closed">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Activity Log"
                   FontSize="20" FontWeight="Bold" Foreground="Cyan" Margin="0,0,0,10"/>

        <ListBox x:Name="LogListBox" Grid.Row="1"
                 Background="#2B2B3C" Foreground="White" FontSize="13" BorderThickness="0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Refresh"
                    Background="#4CAF50" Foreground="White" Padding="10,6" Margin="4"
                    BorderThickness="0" Click="RefreshButton_Click"/>
            <Button x:Name="ShowMoreButton" Content="Show More"
                    Background="#2196F3" Foreground="White" Padding="10,6" Margin="4"
                    BorderThickness="0" Click="ShowMoreButton_Click"/>
            <Button Content="Close"
                    Background="#E53935" Foreground="White" Padding="10,6" Margin="4"
                    BorderThickness="0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>